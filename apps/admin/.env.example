# Copy to apps/admin/.env.local (never commit real values)

# Supabase (public anon key only; RLS enforces admin roles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 (server-only presign route)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=galene-media
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.<your-domain>

# Stripe (server-only, owner Plans & Checkout page)
STRIPE_SECRET_KEY=

# PostHog (optional external dashboard link)
NEXT_PUBLIC_POSTHOG_DASHBOARD_URL=
NEXT_PUBLIC_SITE_URL=https://<your-domain>
